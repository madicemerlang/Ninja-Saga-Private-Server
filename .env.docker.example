# Copy to .env in the repository root before running `docker compose up -d --build`
# Replace 192.168.1.10 with your LAN IP (or your VPS domain with https:// later)

HTTP_PORT=8080
MYSQL_PORT=3306
PVP_PORT=3000
CHAT_PORT=3002

APP_ENV=local
APP_DEBUG=true
APP_URL=http://192.168.1.10:8080

DB_DATABASE=ninjasage
DB_PASSWORD=ninjasage_secret

PVP_SOCKET_URL=http://192.168.1.10:3000/pvp
CHAT_SOCKET_URL=http://192.168.1.10:3002
CHAT_ADMIN_SECRET=change-me-to-a-random-secret
